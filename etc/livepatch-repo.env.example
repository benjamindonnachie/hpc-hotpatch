# install.sh renders this file with the paths chosen at install time
# (--repository-root / --work-root / --state-dir); this copy is only used
# verbatim if install.sh is not run, or for an existing deployment where
# install.sh preserves the file already in place. Edit by hand if needed.

# Profiles for successive minor streams of one EL major/architecture may share
# this repository root. publication.lock serialises their publication steps.
REPOSITORY_ROOT=/srv/klp/repo

# Kernel source trees, ccache and per-job build workspaces: large and
# disposable, kept off the root filesystem.
WORK_ROOT=/var/lib/klp-policy/build/default

# The registry, plan and escalation records: small, durable, the source of
# truth for what has been built and published.
STATE_DIR=/var/lib/livepatch-repo/default/state
